{
  "info": {
    "name": "Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for From The Hart Auth API"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/health",
          "host": ["{{base_url}}"],
          "path": ["auth", "health"]
        }
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register",
          "host": ["{{base_url}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Forgot Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["auth", "forgot-password"]
        }
      }
    },
    {
      "name": "Resend Verification Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/resend-verification",
          "host": ["{{base_url}}"],
          "path": ["auth", "resend-verification"]
        }
      }
    },
    {
      "name": "Verify Email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"<verification_token>\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/verify-email",
          "host": ["{{base_url}}"],
          "path": ["auth", "verify-email"]
        }
      }
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"<reset_token>\",\n  \"password\": \"NewPassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/reset-password",
          "host": ["{{base_url}}"],
          "path": ["auth", "reset-password"]
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/refresh-token",
          "host": ["{{base_url}}"],
          "path": ["auth", "refresh-token"]
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/logout",
          "host": ["{{base_url}}"],
          "path": ["auth", "logout"]
        }
      }
    },
    {
      "name": "Lookup Principal",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer <admin_id_token>" }],
        "url": {
          "raw": "{{base_url}}/auth/lookup?email=friend@gmail.com",
          "host": ["{{base_url}}"],
          "path": ["auth", "lookup"],
          "query": [{ "key": "email", "value": "friend@gmail.com" }]
        }
      }
    },
    {
      "name": "Grant Entitlement",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <admin_id_token>" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"principal_uid\": \"<target_firebase_uid>\",\n  \"entitlement\": \"storage\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/entitlements",
          "host": ["{{base_url}}"],
          "path": ["auth", "entitlements"]
        }
      }
    },
    {
      "name": "Revoke Entitlement",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <admin_id_token>" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"principal_uid\": \"<target_firebase_uid>\",\n  \"entitlement\": \"storage\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/entitlements/revoke",
          "host": ["{{base_url}}"],
          "path": ["auth", "entitlements", "revoke"]
        }
      }
    },
    {
      "name": "Verify ID Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idToken\": \"<jwt_token>\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/verify-id-token",
          "host": ["{{base_url}}"],
          "path": ["auth", "verify-id-token"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://dev-api.fromthehart.tech",
      "type": "string"
    }
  ],
  "_postman_exported_environments": [
    {
      "name": "Dev",
      "values": [
        {
          "key": "base_url",
          "value": "https://dev-api.fromthehart.tech",
          "enabled": true
        }
      ]
    },
    {
      "name": "Prod",
      "values": [
        {
          "key": "base_url",
          "value": "https://api.fromthehart.tech",
          "enabled": true
        }
      ]
    },
    {
      "name": "Local",
      "values": [
        { "key": "base_url", "value": "http://localhost:8080", "enabled": true }
      ]
    },
    {
      "name": "Local Cloudflare Worker",
      "values": [
        { "key": "base_url", "value": "http://localhost:8787", "enabled": true }
      ]
    }
  ]
}
